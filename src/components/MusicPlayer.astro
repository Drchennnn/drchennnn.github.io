---
import '../styles/music-player.css';
---
<aside class="music-player" data-music-player data-audio-src="/music/color-your-night-loop.mp3" data-loop-start="6" data-state="idle" data-collapsed="false" aria-label="背景音乐随身听" transition:persist="night-player" transition:name="night-player" transition:animate="none">
  <button class="player-launcher" data-player-show type="button" aria-label="显示音乐播放器" aria-controls="night-player-panel" aria-expanded="false"><span aria-hidden="true">♫</span> 音乐</button>
  <div data-player-panel id="night-player-panel">
  <div class="player-heading">
    <button type="button" class="player-collapse" data-player-collapse aria-label="隐藏音乐播放器" aria-controls="night-player-panel" title="隐藏播放器，音乐继续播放"><span aria-hidden="true">−</span></button>
  </div>
  <div class="player-device">
    <div class="player-rim" id="night-player-controls">
      <button type="button" data-player-info aria-label="切换显示曲名或歌手" title="曲名 / 歌手"><span aria-hidden="true">INFO</span></button>
      <button type="button" data-player-volume-down aria-label="降低音乐音量" title="音量 −"><span aria-hidden="true">−</span></button>
      <button type="button" data-player-volume-up aria-label="提高音乐音量" title="音量 ＋"><span aria-hidden="true">＋</span></button>
      <button type="button" data-player-restart aria-label="从头播放音乐" title="从头播放"><span aria-hidden="true">↶</span></button>
    </div>
    <div class="player-shell" aria-hidden="true"><span class="player-cap"></span><span class="player-loop-ring"></span></div>
    <button class="player-main" type="button" data-player-play aria-label="播放 Color Your Night" aria-pressed="false" title="播放 / 暂停"><span class="player-play-symbol" aria-hidden="true"></span></button>
    <div class="player-lcd">
      <span class="player-song" data-player-title>COLOR YOUR NIGHT</span>
      <span class="player-loop-label" aria-label="循环播放">↻</span>
      <div class="player-readout"><span class="player-lcd-symbol" aria-hidden="true">▶</span><span data-player-elapsed>00:00</span><span class="player-mode">LOOP</span></div>
      <div class="player-spectrum" aria-hidden="true">{Array.from({ length: 5 }, () => <i data-player-bar></i>)}</div>
    </div>
  </div>
  <div class="player-bottom">
    <a href="https://github.com/sojjeoi/p3r-rainmeter-player" target="_blank" rel="noreferrer" class="player-credit" title="外观灵感：P3R Rainmeter Player">P3R PLAYER ↗</a>
  </div>
  <p class="player-status" data-player-status role="status" aria-live="polite">点击播放音乐</p>
  <noscript><p class="player-no-script">启用 JavaScript 后可播放音乐。</p></noscript>
  </div>
</aside>
<script>
  import { initMusicPlayer } from '../scripts/music-player.mjs';
  initMusicPlayer();
</script>
