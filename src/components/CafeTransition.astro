---
// The supplied Pixi wallpaper spawns a random 512×1024 crowd texture from
// either edge. Its four texture variants are static poses; the original loop
// moves each sprite horizontally and gives it a small 100-frame vertical bob.
const walkers = [
  { side: 'left', depth: 'far', type: '000', frame: 2, delay: '0ms', duration: '3500ms', bob: '-180ms' },
  { side: 'right', depth: 'far', type: '001', frame: 1, delay: '180ms', duration: '3800ms', bob: '-420ms' },
  { side: 'left', depth: 'mid', type: '002', frame: 0, delay: '360ms', duration: '3200ms', bob: '-80ms' },
  { side: 'right', depth: 'mid', type: '003', frame: 3, delay: '420ms', duration: '3400ms', bob: '-520ms' },
  { side: 'left', depth: 'front', type: '004', frame: 1, delay: '620ms', duration: '3100ms', bob: '-280ms' },
  { side: 'right', depth: 'front', type: '005', frame: 2, delay: '760ms', duration: '3300ms', bob: '-640ms' },
  { side: 'left', depth: 'mid', type: '001', frame: 3, delay: '980ms', duration: '3600ms', bob: '-360ms' },
  { side: 'right', depth: 'mid', type: '004', frame: 0, delay: '1100ms', duration: '3500ms', bob: '-40ms' },
];
---
<div class="hero-switch" data-cafe-transition aria-hidden="true" hidden>
  {walkers.map(({ side, depth, type, frame, delay, duration, bob }) => (
    <div class:list={['commuter', `commuter--${side}`, `commuter--${depth}`]} style={`--delay:${delay};--duration:${duration};--bob:${bob}`}>
      <span class="commuter-sprite" style={`background-image:url('/images/crowd/crowd-${type}-${frame}.png')`}></span>
    </div>
  ))}
</div>
