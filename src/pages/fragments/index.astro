  <section class="simple">
    <a class="back" href="/daily/">← 返回日常记录</a>
    <header class="article-heading">
      <h1><TitleReveal>每日碎片</TitleReveal></h1>
      <p class="lede">日记、照片与月度回顾，仅本人登录后可见。</p>
    </header>
    <div class="actions">
      <a class="button" href="https://daily-fragments.drchennnn.workers.dev/" rel="noreferrer" data-astro-reload>打开私人日记 <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Base>
