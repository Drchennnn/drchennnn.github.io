---
import Base from '../layouts/Base.astro';
import RevealText from '../components/RevealText.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a,b) => b.data.date.valueOf()-a.data.date.valueOf() || a.id.localeCompare(b.id));
const photos = await getCollection('photos', ({ data }) => !data.draft);
const toys = await getCollection('toys', ({ data }) => !data.draft);
const date = (d: Date) => d.toISOString().slice(0,10).replaceAll('-', '.');
---
<Base>
<div class="opening-screen" data-opening aria-hidden="true">
  <div class="opening-quote">
    <p><img src="/p3r/memento-mori.svg" alt="Memento Mori" width="251" height="30"></p>
    <span>Time never waits.</span>
    <span>Every day, a new chapter.</span>
  </div>
  <div class="opening-water">
    <svg viewBox="0 0 1440 160" preserveAspectRatio="none"><path d="M0 100Q180 40 360 100T720 100T1080 100T1440 100V160H0Z"/><path d="M0 110Q180 65 360 110T720 110T1080 110T1440 110V160H0Z"/></svg>
  </div>
</div>
<section class="reload-hero" aria-labelledby="welcome-title">
<div class="hero-media">
<picture class="hero-poster"><source media="(max-width: 900px), (max-aspect-ratio: 1/1)" srcset="/p3r/hero-poster-mobile.jpg"><img src="/p3r/hero-poster.webp" alt="" width="1600" height="900" fetchpriority="high"></picture>
<video class="hero-film hero-film-intro" data-hero-intro data-src="/p3r/hero-intro.mp4" data-mobile-src="/p3r/hero-intro-mobile.mp4" muted playsinline preload="none" aria-hidden="true" tabindex="-1"></video>
<video class="hero-film" data-hero-video data-src="/p3r/hero-loop.mp4" data-mobile-src="/p3r/hero-loop-mobile.mp4" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1">
</video>
</div>
<div class="hero-coordinate" aria-hidden="true">THE DAYS ARE OURS.<br>01 — PERSONAL ARCHIVE</div>
<div class="reload-title">
<p class="hero-kicker">LINK / PERSONAL RECORDS — 01</p>
<p class="hero-display" aria-hidden="true">
<span>RELOAD</span>
<br/>
<em>YOUR DAYS.</em>
</p>
<h1 id="welcome-title">每一天，都是新的记录。</h1>
<p class="hero-intro">日常、学习，和一点不愿放下的好奇。<br>这是 Link 的个人记录。</p>
<a class="reload-cta" href="#recent">START / 开始探索 <span aria-hidden="true">↗</span>
</a>
</div>
<div class="hero-bottom">
<span>PERSONAL ARCHIVE / LINK</span>
<a href="#recent">SCROLL TO EXPLORE <span aria-hidden="true">↓</span>
</a>
</div>
</section>
<div class="home-content">
<section class="entries reload-entries" id="recent" aria-labelledby="list-title">
<div class="editorial-heading">
<p class="section-index" data-reveal>01 / THE LATEST</p>
<h2 id="list-title">
<span aria-hidden="true"><RevealText text="LATEST"/><br/>
<i><RevealText text="RECORDS." delay={100}/></i>
</span>
<b data-reveal style="--reveal-delay:180ms">最新记录</b>
</h2>
<p class="reveal-lines"><span data-reveal>一些经历，一些发现。</span><span data-reveal style="--reveal-delay:160ms">把走过的路，写成下一页。</span></p>
</div>
<div class="entry-column">
<div class="entry-count" data-reveal>
<span>RECENT UPDATES</span>
<span>{String(posts.length).padStart(2, '0')} RECORDS</span>
</div>
<ol>{posts.slice(0, 6).map((post, index) => <li data-reveal style={`--reveal-delay:${index * 100}ms`}>
<a class="entry" href={`/posts/${post.id}/`}>
<span class="entry-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
<div>
<p class="entry-kind">{post.data.category === 'study' ? 'STUDY / 学习档案' : 'LOG / 日常记录'}<time datetime={post.data.date.toISOString()}>{date(post.data.date)}</time>
</p>
<h3>{post.data.title}</h3>{post.data.description && <p>{post.data.description}</p>}</div>
<span class="arrow" aria-hidden="true">↗</span>
</a>
</li>)}</ol>
<a href="/search/" class="archive-link" data-reveal>探索全部记录 <span aria-hidden="true">→</span>
</a>
</div>
</section>
</div>
<section class="chapter-section" aria-labelledby="chapters-title">
<div class="chapter-top">
<div>
<p class="section-index" data-reveal>02 / CHOOSE YOUR CHAPTER</p>
<h2 id="chapters-title" aria-label="ARCHIVE 选择你的下一段记录"><span class="chapter-title-en" aria-hidden="true"><RevealText text="ARCHIVE"/></span><span data-reveal style="--reveal-delay:180ms">选择你的下一段记录</span>
</h2>
</div>
<div class="chapter-controls">
<button type="button" data-gallery-prev aria-label="上一组分类">←</button>
<button type="button" data-gallery-next aria-label="下一组分类">→</button>
</div>
</div>
<div class="chapter-gallery" tabindex="0" aria-label="分类画廊，可左右滚动">
<a href="/daily/" class="chapter-card" data-chapter="1" data-reveal="image">
<img src="/p3r/chapter-1.webp" alt="" width="570" height="760" loading="lazy">
<span class="chapter-id">01 / {String(posts.filter(post => post.data.category === 'daily').length).padStart(2, '0')} RECORDS</span>
<div class="chapter-copy">
<p>LOG</p>
<h3>日常记录<span aria-hidden="true">↗</span>
</h3>
<small>在普通的日子里，捕捉不普通的瞬间。</small>
</div>
</a>
<a href="/study/" class="chapter-card" data-chapter="2" data-reveal="image" style="--reveal-delay:100ms">
<img src="/p3r/chapter-2.webp" alt="" width="570" height="760" loading="lazy">
<span class="chapter-id">02 / {String(posts.filter(post => post.data.category === 'study').length).padStart(2, '0')} RECORDS</span>
<div class="chapter-copy">
<p>STUDY</p>
<h3>学习档案<span aria-hidden="true">↗</span>
</h3>
<small>让每一次好奇，生长出新的答案。</small>
</div>
</a>
<a href="/photos/" class="chapter-card" data-chapter="3" data-reveal="image" style="--reveal-delay:200ms">
<img src="/p3r/chapter-3.webp" alt="" width="570" height="760" loading="lazy">
<span class="chapter-id">03 / {String(photos.length).padStart(2, '0')} RECORDS</span>
<div class="chapter-copy">
<p>GALLERY</p>
<h3>光影片段<span aria-hidden="true">↗</span>
</h3>
<small>一些光，一些影，一些不想忘记的画面。</small>
</div>
</a>
<a href="/play/" class="chapter-card" data-chapter="4" data-reveal="image" style="--reveal-delay:300ms">
<img src="/p3r/chapter-4.webp" alt="" width="570" height="760" loading="lazy">
<span class="chapter-id">04 / {String(toys.length).padStart(2, '0')} RECORDS</span>
<div class="chapter-copy">
<p>LAB</p>
<h3>交互实验<span aria-hidden="true">↗</span>
</h3>
<small>把一闪而过的念头，变成可以触碰的东西。</small>
</div>
</a>
</div>
<p class="gallery-hint">四个入口，同一本未完的记录。<span>DRAG / SCROLL TO DISCOVER →</span>
</p>
</section>
<section class="reload-about" aria-labelledby="about-title">
<div class="about-water" data-reveal="image" aria-hidden="true">
<span>STAY<br/>
<i>CURIOUS.</i>
</span>
<svg viewBox="0 0 420 420">
<circle cx="210" cy="210" r="175">
</circle>
<circle cx="210" cy="210" r="135">
</circle>
<path d="M20 210H400M210 20V400">
</path>
</svg>
</div>
<div class="about-copy">
<p class="section-index" data-reveal>03 / BEHIND THE PAGES</p>
<img src="/images/link-avatar.webp" alt="Link 的头像" width="72" height="72" loading="lazy">
<h2 id="about-title" data-reveal>你好，我是 Link。</h2>
<p class="reveal-lines"><span data-reveal>一半日常，一半好奇。</span><span data-reveal style="--reveal-delay:130ms">学习、记录、动手尝试，在这里留下自己的轨迹。</span><span data-reveal style="--reveal-delay:260ms">不必每一次探索都有结论，下一页总有新的可能。</span></p>
<a class="archive-link" href="/about/" data-reveal>关于我 <span aria-hidden="true">↗</span>
</a>
</div>
</section>
</Base>
