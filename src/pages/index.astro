---
import Base from '../layouts/Base.astro';
import CafeScene from '../components/CafeScene.astro';
import CafeTransition from '../components/CafeTransition.astro';
import '../styles/cafe-people.css';
import { getCollection } from 'astro:content';
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a,b) => b.data.date.valueOf()-a.data.date.valueOf() || a.id.localeCompare(b.id));
const photos = await getCollection('photos', ({ data }) => !data.draft);
const toys = await getCollection('toys', ({ data }) => !data.draft);
const date = (d: Date) => d.toISOString().slice(0,10).replaceAll('-', '.');
---
<Base>
  <section class="cafe-hero" aria-labelledby="welcome-title">
    <div class="hero-copy"><p class="eyebrow">WELCOME TO THE COUNTER</p><h1 id="welcome-title">雨歇之前，<br/><em>坐一会儿。</em></h1><p class="lede">街角的灯还亮着，咖啡刚好温热。<br/>把日常、学习和一点好奇，<br/>慢慢写在这里。</p><a class="author-note" href="/about/"><img src="/images/link-avatar.webp" alt="Link 的头像" width="48" height="48" fetchpriority="high"/><span><strong>Link</strong><small>一半日常，一半好奇。</small></span><span aria-hidden="true">↗</span></a><a class="open-note" href="#recent"><i aria-hidden="true"></i>OPEN FOR A LITTLE WHILE <span aria-hidden="true">↓</span></a></div>
    <CafeScene />
    <p class="scene-caption"><span data-scene-status>白昼 · 晴天</span><span>同一扇窗，不同的光。</span></p>
    <CafeTransition />
  </section>
  <div class="home-content">
    <section class="entries" id="recent" aria-labelledby="list-title"><div class="section-label"><div><p class="eyebrow">FRESH FROM THE COUNTER</p><h2 id="list-title">新近手记</h2></div><span>{String(posts.length).padStart(2, '0')} 篇文章</span></div>
      {posts.length ? <ol>{posts.slice(0, 6).map(post => <li><a class="entry" href={`/posts/${post.id}/`}><time datetime={post.data.date.toISOString()}>{date(post.data.date)}</time><div><p class="entry-kind">{post.data.category === 'study' ? 'STUDY / 研磨笔记' : 'DAILY / 吧台手记'}</p><h3>{post.data.title}</h3>{post.data.description && <p>{post.data.description}</p>}</div><span class="arrow" aria-hidden="true">↗</span></a></li>)}</ol> : <div class="empty">这里留一页空白，等下一次值得写下的日常。</div>}
    </section>
    <section aria-labelledby="menu-title"><div class="section-label"><div><p class="eyebrow">ON THE MENU</p><h2 id="menu-title">柜台菜单</h2></div><span>随意翻翻</span></div><div class="shelves">
      <a class="shelf" href="/daily/"><span>01 / DAILY</span><h3>吧台手记</h3><p>日常随笔，细碎见闻。</p><b>{String(posts.filter(post => post.data.category === 'daily').length).padStart(2, '0')}</b></a>
      <a class="shelf" href="/study/"><span>02 / STUDY</span><h3>研磨笔记</h3><p>学习所得，思考留痕。</p><b>{String(posts.filter(post => post.data.category === 'study').length).padStart(2, '0')}</b></a>
      <a class="shelf" href="/photos/"><span>03 / PHOTO</span><h3>窗边相册</h3><p>把偶遇的光留在窗边。</p><b>{String(photos.length).padStart(2, '0')}</b></a>
      <a class="shelf" href="/play/"><span>04 / PLAY</span><h3>桌边小物</h3><p>有一点想法，就动手试试。</p><b>{String(toys.length).padStart(2, '0')}</b></a>
    </div></section>
  </div>
</Base>
