---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ReadingTools from '../../components/ReadingTools.astro';
import TitleReveal from '../../components/TitleReveal.astro';
export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map(post => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const chapterHeadings = headings.filter(({ depth }) => depth === 2 || depth === 3);
---
<Base title={post.data.title} description={post.data.description} category={post.data.category}>
  <article class="article"><a class="back" href={`/${post.data.category}/`}>← 返回{post.data.category === 'study' ? '学习档案' : '日常记录'}</a><div class="article-heading"><time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0,10).replaceAll('-', '.')}</time><h1><TitleReveal>{post.data.title}</TitleReveal></h1>{post.data.description && <p class="lede">{post.data.description}</p>}</div><ReadingTools headings={chapterHeadings} /><div class="prose"><Content /></div><div class="article-end"><span>— 完 —</span><a href={`/${post.data.category}/`}>查看同组文章 →</a></div></article>
</Base>
