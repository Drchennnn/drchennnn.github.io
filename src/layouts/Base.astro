---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = '日常手帖', description = 'Drchennnn 的个人博客，记录日常与想法。' } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · Drchennnn</title><meta name="description" content={description} />
  <link rel="canonical" href={new URL(path, Astro.site)} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <a class="skip" href="#main">跳至正文</a>
  <div class="shell">
    <header><a class="brand" href="/"><span class="seal" aria-hidden="true">日<br/>常</span><span>日常手帖<small>DRCHENNNN / JOURNAL</small></span></a>
      <nav aria-label="主导航"><a href="/" aria-current={path === '/' || path.startsWith('/posts/') ? 'page' : undefined}>文章</a><a href="/about/" aria-current={path === '/about/' ? 'page' : undefined}>关于</a><a href="https://github.com/Drchennnn" target="_blank" rel="noreferrer">GitHub ↗</a></nav>
    </header>
    <main id="main"><slot /></main>
    <footer><span>© {new Date().getFullYear()} Drchennnn<span class="footer-note">慢慢记录，好好生活。</span></span><a href="/manage/">文章管理 ↗</a></footer>
  </div>
</body>
</html>
