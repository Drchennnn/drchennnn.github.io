---
import '../styles/global.css';
import '../styles/p3r.css';
import '../styles/p3r-menu.css';
import '../styles/p3r-opening.css';
import ReloadMotion from '../components/ReloadMotion.astro';
interface Props { title?: string; description?: string; category?: 'daily' | 'study'; }
const { title = 'LINK RELOAD · 青蓝档案', description = 'Link 的个人档案：日常记录、学习档案、光影片段与交互实验。' } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  ['/daily/', 'LOG', '日常记录'], ['/study/', 'STUDY', '学习档案'], ['/photos/', 'GALLERY', '光影片段'],
  ['/play/', 'LAB', '交互实验'], ['/search/', 'SEARCH', '记录检索'], ['/about/', 'PROFILE', '关于 Link']
];
---
<!doctype html>
<html lang="zh-CN" data-theme-version="P3R-RELOAD-1" data-motion="on">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · Link</title><meta name="description" content={description} />
  <meta name="theme-color" content="#0649bd" />
  <link rel="canonical" href={new URL(path, Astro.site)} />
  <link rel="icon" href="/brand-reload.svg" type="image/svg+xml" />
  <script is:inline>
    const r = document.documentElement;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let paused = false;
    try { paused = localStorage.getItem('journal-motion') === 'off'; } catch {}
    const saveData = Boolean(window.navigator?.connection?.saveData);
    r.dataset.motion = paused || reduce ? 'off' : 'on';
    if (window.location?.pathname === '/' && !paused && !reduce && !saveData) {
      r.dataset.opening = 'blue';
      window.setTimeout?.(() => { if (!r.dataset.openingManaged) delete r.dataset.opening; }, 4000);
      window.setTimeout?.(() => {
        if (r.dataset.opening && r.dataset.opening !== 'ready') {
          r.dataset.opening = 'ready';
          delete r.dataset.openingManaged;
        }
      }, 15000);
    }
  </script>
</head>
<body>
  <a class="skip" href="#main">跳至正文</a>
  <div class:list={['site', { 'site-home': path === '/' }]}>
    <div class="topline" aria-hidden="true"></div>
    <header class="site-header">
      <a class="brand" href="/" aria-label="LINK RELOAD，返回首页"><img class="brand-symbol" src="/brand-reload.svg" alt="" width="64" height="64"/><span class="brand-wordmark">LINK<span class="brand-reload">RELOAD</span><small>青蓝档案 / PERSONAL RECORDS</small></span></a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">MENU <span aria-hidden="true">＋</span></button>
      <nav id="main-nav" aria-label="主导航">{nav.map(([href,en,label],index) => <a href={href} aria-current={path.startsWith(href) || (path.startsWith('/posts/') && href === `/${Astro.props.category}/`) ? 'page' : undefined}><small aria-hidden="true">0{index+1}</small><span class="nav-en" aria-hidden="true">{en}</span><span class="nav-zh">{label}</span></a>)}</nav>
    </header>
    <div class="atmosphere-bar"><a href="/">EVERY DAY, A NEW CHAPTER <span>日常 · 探索 · 未完待续</span></a><span class="build-label">LINK / PERSONAL ARCHIVE</span></div>
    <main id="main" class:list={{ 'home-main': path === '/' }}><slot /></main>
    <footer><div>© {new Date().getFullYear()} Link <span class="footer-note">RECORD. EXPLORE. RELOAD.</span><small>P3R-inspired personal archive · 第三方参考素材 ©ATLUS ©SEGA</small></div><div class="footer-links"><button class="motion-toggle" type="button" aria-pressed="false">暂停动效</button><a href="https://github.com/Drchennnn" target="_blank" rel="noreferrer">GitHub ↗</a><a href="/admin/">管理登录</a></div></footer>
  </div>
  <ReloadMotion />
</body>
</html>
