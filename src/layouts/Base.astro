---
import '../styles/global.css';
import '../styles/cafe.css';
import JournalMotion from '../components/JournalMotion.astro';
import CafeControls from '../components/CafeControls.astro';
interface Props { title?: string; description?: string; category?: 'daily' | 'study'; }
const { title = '雨歇之前', description = 'Link 的个人博客。在卢布朗的咖啡香里，写下日常、学习和一点好奇。' } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  ['/daily/', '吧台手记'], ['/study/', '研磨笔记'], ['/photos/', '窗边相册'],
  ['/play/', '桌边小物'], ['/search/', '寻一页'], ['/about/', '店主便笺']
];
---
<!doctype html>
<html lang="zh-CN" data-mode="day" data-weather="dry" data-motion="on">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · Link</title><meta name="description" content={description} />
  <meta name="theme-color" content="#211b17" />
  <link rel="canonical" href={new URL(path, Astro.site)} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <script is:inline>
    try { const r=document.documentElement; r.dataset.mode=localStorage.getItem('leblanc-mode')==='night'?'night':'day'; r.dataset.weather=localStorage.getItem('leblanc-weather')==='rain'?'rain':'dry'; r.dataset.motion=localStorage.getItem('journal-motion')==='off'||matchMedia('(prefers-reduced-motion: reduce)').matches?'off':'on'; } catch {}
  </script>
</head>
<body>
  <a class="skip" href="#main">跳至正文</a>
  <div class="site">
    <div class="topline" aria-hidden="true"></div>
    <header class="site-header">
      <a class="brand" href="/" aria-label="雨歇之前，返回店内"><span class="crest" aria-hidden="true">L</span><span>雨歇之前<small>LINK / CAFÉ LEBLANC</small></span></a>
      <nav aria-label="主导航">{nav.map(([href,label]) => <a href={href} aria-current={path.startsWith(href) || (path.startsWith('/posts/') && href === `/${Astro.props.category}/`) ? 'page' : undefined}>{label}</a>)}</nav>
    </header>
    <div class="atmosphere-bar"><a href="/">COFFEE &amp; CURRY <span>一杯咖啡，一页日常。</span></a><CafeControls /></div>
    <main id="main" class:list={{ 'home-main': path === '/' }}><slot /></main>
    <footer><div>© {new Date().getFullYear()} Link <span class="footer-note">慢慢写，坐一会儿。</span><small>受 Café Leblanc 启发的个人博客</small></div><div class="footer-links"><button class="motion-toggle" type="button" aria-pressed="false">暂停动效</button><a href="https://github.com/Drchennnn" target="_blank" rel="noreferrer">GitHub ↗</a><a href="/admin/">管理登录</a><span class="music-note">♫ 音乐留座 · 暂未载入</span></div></footer>
  </div>
  <JournalMotion />
</body>
</html>
