<div class="wind-corner">
  <span class="wind-note" aria-hidden="true">風の便り</span>
  <button class="wind-chime" type="button" aria-label="让风铃轻轻摇动" title="借一阵风">
    <svg viewBox="0 0 180 280" fill="none" aria-hidden="true">
      <g class="chime-swing">
        <path class="chime-cord" d="M90 0v63" />
        <path class="chime-glass" d="M48 113c2-36 17-53 42-53s40 17 42 53c-24 9-60 9-84 0Z" />
        <path class="chime-cord" d="M48 113c23-7 61-7 84 0M90 61v84" />
        <path class="chime-reflection" d="M64 88c3-8 7-13 12-15" />
        <path class="chime-leaf" d="M91 88c11-9 17-5 17-5-2 11-11 15-17 5Zm-3 8c-11-7-16-3-16-3 3 10 10 12 16 3Z" />
        <circle cx="90" cy="124" r="3" fill="currentColor" />
        <g class="chime-paper">
          <path d="m77 145 26-2 8 92-28 3Z" fill="var(--paper)" stroke="currentColor" stroke-width=".8" />
          <path d="m79 146 24-2 1 10-24 2Z" fill="currentColor" opacity=".13" />
